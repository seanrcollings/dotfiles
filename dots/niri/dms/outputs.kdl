// Laptop display configuration (from Sway config)
output "eDP-1" {
    scale 1.2
    position x=0 y=1440
}

// Lid switch handling
// Note: Niri doesn't have bindswitch like Sway
// You may need to use a separate tool like acpid or systemd-logind
// to handle lid events and run: niri msg output eDP-1 off/on
